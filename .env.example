# 사내 self-hosted GitLab이면 해당 URL, gitlab.com이면 https://gitlab.com
GITLAB_URL=https://gitlab.example.com

# Settings > Access Tokens 에서 발급, scope는 최소 "api" (read-only면 read_api로 충분)
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# 기본 프로젝트(들). project ID 또는 group/repo 경로, 여러 개면 쉼표로 구분.
# --projects CLI 옵션을 따로 주면 이 값 대신 그게 우선 적용됨.
GITLAB_PROJECTS=dap-team/lending-platform
